# One LINODE_TOKEN_<NAME> per config file in latr-configs/
# <NAME> = filename without .yaml, UPPERCASED, hyphens replaced with underscores
#
# Example: latr-configs/primary.yaml  →  LINODE_TOKEN_PRIMARY
#          latr-configs/secondary.yaml →  LINODE_TOKEN_SECONDARY

LINODE_TOKEN_PRIMARY=your-linode-api-token-here
# LINODE_TOKEN_SECONDARY=another-token-here
